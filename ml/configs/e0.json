{
  "experiment": "E0",
  "description": "Public-data baseline: live-to-live verification on held-out public animals",
  "dataset": {
    "name": "Xiong et al. (2022) beef cattle muzzle database",
    "doi": "10.5281/zenodo.6324361",
    "archive_sha256": "0a4b519f300e0d96727c60f4515fd8cb6e2c74eaaa1f6fdc43d23b8e44693c1c"
  },
  "split": {"seed": 42, "fractions": [0.6, 0.2, 0.2]},
  "protocol": {"k_enrol": 3, "role_order": "capture"},
  "near_duplicate_max_bits": 2,
  "image_cache_size": 256,
  "train": {
    "loss": "arcface",
    "epochs": 15,
    "batch_size": 48,
    "lr": 0.0005,
    "weight_decay": 0.0001,
    "embedding_dim": 512,
    "image_size": 224,
    "arc_scale": 30.0,
    "arc_margin": 0.3,
    "seed": 42
  },
  "sift": {"impostors_per_query": 10, "seed": 11},
  "bootstrap": {"n_resamples": 1000, "seed": 0},
  "far_targets": [0.01, 0.001],
  "lbp_candidates": [[64, 4], [96, 4], [128, 4], [128, 8]],
  "app": {
    "model_version": "pmid-lbp-demo-v0.1",
    "threshold_version": "e0-lbp-dev-v0.1",
    "quality": {"min_side": 256, "min_brightness": 50, "max_brightness": 220, "min_sharpness": 15}
  }
}
